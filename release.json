{
  "product": "Мила Компаньон",
  "version": "1.4.0-rc4",
  "tag": "v1.4.0-rc4",
  "date": "2026-10-17",
  "notes": "CHANGELOG.md - section v1.4.0-rc4",
  "zones": [
    {
      "what": "навыки ядра",
      "src": "skills/*",
      "dst": "{claude}/skills/*",
      "kind": "dir"
    },
    {
      "what": "хуки и инструменты",
      "src": "install/*.py",
      "dst": "{claude}/hooks/*",
      "kind": "file",
      "skip": [
        "test_*.py"
      ]
    },
    {
      "what": "запускатель",
      "src": "install/mila",
      "dst": "{home}/.local/bin/mila",
      "kind": "file"
    },
    {
      "what": "конституция",
      "src": "CONSTITUTION.md",
      "dst": "{work}/CONSTITUTION.md",
      "kind": "file"
    },
    {
      "what": "хуки шаблона",
      "src": "templates/home/.claude/hooks/*.py",
      "dst": "{claude}/hooks/*",
      "kind": "file",
      "skip": [
        "test_*.py"
      ]
    },
    {
      "what": "каноны",
      "src": "canon/*.md",
      "dst": "{work}/canon/*",
      "kind": "file",
      "skip": [
        "TEAM-CONTACTS*"
      ]
    }
  ],
  "never": [
    "{work}/NOW.md",
    "{work}/USER.md",
    "{work}/CLIENTS.md",
    "{work}/DECISIONS.md",
    "{work}/CLAUDE.md",
    "{work}/memory",
    "{work}/journal",
    "{work}/BACKLOG.md",
    "{work}/AUTO-POOL.md",
    "{work}/PERMISSIONS.md",
    "{claude}/settings.json",
    "{claude}/channels",
    "{claude}/projects",
    "{home}/secrets",
    "{work}/.env",
    "{work}/rituals",
    "{work}/canon/TEAM-CONTACTS.md"
  ],
  "genes": [
    "skills/mila-export",
    "skills/mila-update",
    "install/mila"
  ],
  "genes_note": "every Mila carries these: she can update herself and export herself (owner owns the archive)",
  "renamed": {
    "ekzamen": "exam",
    "kartochki": "cards",
    "lichka-hozyaina": "owner-dm",
    "mila-v-chate": "mila-in-chat",
    "naglyadno": "visual",
    "proverka": "verify",
    "put-gostya": "guest-path",
    "rashod": "spend",
    "topiki": "topics",
    "vhodyashchie": "inbox",
    "vkusy": "tastes",
    "voprosy": "questions",
    "yasno": "plain-words",
    "zadachi": "tasks",
    "znakomstvo": "onboarding",
    "OBDUMYVANIE.md": "THINKING-BUDGET.md"
  },
  "renamed_note": "v1.4.0 international names; old names are aliases (MOVED.md + script wrappers, no SKILL.md) until v1.6.0"
}
